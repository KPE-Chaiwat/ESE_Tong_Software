{
  "name": "esefact",
  "version": "0.3.0",
  "author": "tong_ese",
  "license": "MIT",
  "private": true,
  "description": "ESEfact monorepo root. Scripts here are the single entry point for dev, build, checks and tests.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @esefact/desktop tauri dev",
    "dev:web": "pnpm --filter @esefact/desktop dev:web",
    "build": "pnpm build:cli && pnpm --filter @esefact/desktop tauri build --config src-tauri/tauri.cli.conf.json",
    "build:cli": "node scripts/build-modbus-master-cli.mjs",
    "build:web": "pnpm --filter @esefact/desktop build:web",
    "bindings": "node scripts/gen-bindings.mjs",
    "bindings:check": "node scripts/gen-bindings.mjs --check",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "typecheck": "pnpm --filter @esefact/desktop typecheck && pnpm --filter @esefact/e2e typecheck",
    "lint": "pnpm lint:rust && pnpm lint:web",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:web": "pnpm --filter @esefact/desktop lint",
    "test": "pnpm test:rust && pnpm test:web",
    "test:rust": "node scripts/test-rust.mjs",
    "test:rust:nextest": "node scripts/test-rust.mjs --nextest",
    "test:web": "pnpm --filter @esefact/desktop test",
    "e2e": "pnpm --filter @esefact/e2e test",
    "check": "pnpm version:check && pnpm bindings:check && pnpm typecheck && pnpm lint && pnpm test"
  }
}
